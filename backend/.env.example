# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" não vai para o git (contém segredos).

# Banco de dados. Estes valores combinam com o docker-compose.yml da raiz.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expenseflow?schema=public"

# Segredo usado para assinar os tokens de login. Troque por um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Porta da API (o frontend espera a 3001)
PORT=3001

# Opcionais
# Endereço(s) do frontend autorizados a chamar a API, separados por vírgula (padrão: http://localhost:3000)
# CORS_ORIGIN=http://localhost:3000
# Limite de requisições por minuto, por IP: nas rotas de login/cadastro (padrão 5) e nas demais (padrão 120)
# AUTH_THROTTLE_LIMIT=5
# THROTTLE_LIMIT=120
